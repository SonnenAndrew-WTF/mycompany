# Пример локальных настроек сервера lsFusion.
# Скопируйте в conf/settings.properties и укажите свои значения — этот файл не хранится в git.
db.server=localhost
db.name=mycompany
db.user=postgres
db.password=

rmi.port=7652

#user.setLanguage=en
